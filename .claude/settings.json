{
  "permissions": {
    "allow": [
      "Bash(rsync:*)"
    ],
    "deny": [
      "Bash(python -m venv *)",
      "Bash(python3 -m venv *)",
      "Bash(python3.* -m venv *)",
      "Bash(virtualenv *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(python -m ensurepip *)",
      "Bash(python3 -m ensurepip *)",
      "Bash(poetry install *)",
      "Bash(pipx install *)",
      "Bash(conda install *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh run"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/chat-mode.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh run"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh idle"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh idle"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh fail"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh off"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 -S ~/.local/share/progress-hud/scripts/statusline.py --wrap claude-hud",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "crowdsec@claude-plugins-official": true,
    "nvidia-skills@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "nixd-lsp@mandragora": true,
    "progress-hud@progress-hud": true
  },
  "extraKnownMarketplaces": {
    "tellonce": {
      "source": {
        "source": "github",
        "repo": "YujunZhou/tellonce"
      }
    },
    "mandragora": {
      "source": {
        "source": "directory",
        "path": "/etc/nixos/mandragora/agent-plugins"
      }
    },
    "progress-hud": {
      "source": {
        "source": "github",
        "repo": "mvrozanti/progress-hud"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
