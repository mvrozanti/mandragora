[default]
default_calendar = hotmail

[view]
agenda_event_format = {calendar-color}{cancelled}{start-end-time-style} {title}{repeat-symbol}{description-separator}{description}{reset}
dynamic_days = True
bold_for_light_color = False

[calendars]

    [[hotmail]]
    path = ~/.local/share/calendars/hotmail/calendar
    type = calendar

    [[feriados]]
    path = ~/.local/share/calendars/hotmail/Feriados no Brasil
    type = calendar
    readonly = True

    [[google]]
    path = ~/.local/share/calendars/google/*
    type = discover

[locale]
timeformat = %H:%M
dateformat = %d/%m/%Y
longdateformat = %d/%m/%Y
datetimeformat = %d/%m/%Y %H:%M
longdatetimeformat = %d/%m/%Y %H:%M
