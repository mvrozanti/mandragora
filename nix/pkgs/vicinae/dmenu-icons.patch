 void DMenuSection::setRawEntries(std::vector<std::string_view> entries) {
+  m_icons.clear();
+  if (m_iconColumn) {
+    for (auto &e : entries) {
+      auto const tab = e.find('\t');
+      if (tab == std::string_view::npos) {
+        m_icons.emplace_back();
+        continue;
+      }
+      m_icons.push_back(e.substr(0, tab));
+      e = e.substr(tab + 1);
+    }
+  }
   m_entries = std::move(entries);
