+bool Group::handleScroll(GdkEventScroll* e) {
+  if (!cycle_on_scroll || revealed || slots.size() < 2) {
+    return false;
+  }
+  const auto dir = getScrollDir(e);
+  int step = 0;
+  if (dir == SCROLL_DIR::DOWN || dir == SCROLL_DIR::RIGHT) {
+    step = 1;
+  } else if (dir == SCROLL_DIR::UP || dir == SCROLL_DIR::LEFT) {
+    step = -1;
+  }
+  if (step == 0) {
+    return true;
+  }
+  const int count = static_cast<int>(slots.size());
+  int next = shown();
+  for (int tries = 0; tries < count; tries++) {
+    next = (next + step + count) % count;
+    if (slot_widgets[next]->get_visible()) {
+      break;
+    }
+  }
+  cycle_to(next);
+  save_state();
+  return true;
+}
+
+Gtk::RevealerTransitionType Group::slide(bool toward_start) const {
+  if (vertical_) {
+    return toward_start ? Gtk::RevealerTransitionType::REVEALER_TRANSITION_TYPE_SLIDE_UP
+                        : Gtk::RevealerTransitionType::REVEALER_TRANSITION_TYPE_SLIDE_DOWN;
+  }
+  return toward_start ? Gtk::RevealerTransitionType::REVEALER_TRANSITION_TYPE_SLIDE_LEFT
+                      : Gtk::RevealerTransitionType::REVEALER_TRANSITION_TYPE_SLIDE_RIGHT;
+}
+
+void Group::cycle_to(int next) {
+  const int previous = shown();
+  shown_index = next;
+  const bool forward = next > previous;
+  for (int i = 0; i < static_cast<int>(slots.size()); i++) {
+    auto& slot = *slots[i];
+    const bool at_rest = slot.get_child_revealed() == slot.get_reveal_child();
+    if (at_rest && i == next) {
+      slot.set_transition_type(slide(forward));
+    } else if (at_rest && i == previous) {
+      slot.set_transition_type(slide(!forward));
+    }
+    slot.set_reveal_child(i == next);
+    auto style = slot_widgets[i]->get_style_context();
+    if (i == next) {
+      style->remove_class(add_class_to_drawer_children);
+    } else {
+      style->add_class(add_class_to_drawer_children);
+    }
+  }
+}
+
+int Group::shown() const {
+  const int count = static_cast<int>(slots.size());
+  if (shown_index < count) {
+    return shown_index;
+  }
+  return std::min(leader_index, count - 1);
+}
+
+void Group::apply_slots(bool animate) {
+  const int current = shown();
+  for (int i = 0; i < static_cast<int>(slots.size()); i++) {
+    auto& slot = *slots[i];
+    const bool visible = revealed || i == current;
+    if (i < current) {
+      slot.set_transition_type(getPreferredTransitionType(vertical_));
+    } else {
+      slot.set_transition_type(
+          vertical_ ? Gtk::RevealerTransitionType::REVEALER_TRANSITION_TYPE_SLIDE_DOWN
+                    : Gtk::RevealerTransitionType::REVEALER_TRANSITION_TYPE_SLIDE_RIGHT);
+    }
+    slot.set_transition_duration(animate ? transition_duration : 0);
+    slot.set_reveal_child(visible);
+    slot.set_transition_duration(transition_duration);
+    auto style = slot_widgets[i]->get_style_context();
+    if (i == current) {
+      style->remove_class(add_class_to_drawer_children);
+    } else {
+      style->add_class(add_class_to_drawer_children);
+    }
+  }
+}
+
+void Group::save_state() {
+  if (state_path.empty()) {
+    return;
+  }
+  std::ofstream out(state_path, std::ios::trunc);
+  out << (revealed ? '1' : '0');
+  if (leader_index >= 0) {
+    out << ' ' << shown();
+  }
+}
