+static std::array<unsigned char, 256> buildGammaTable()
+{
+    std::array<unsigned char, 256> table;
+    const char * value = std::getenv("KEYLEDS_GAMMA");
+    double gamma = value != nullptr ? std::atof(value) : 1.0;
+    if (!(gamma > 0.0)) { gamma = 1.0; }
+    for (std::size_t i = 0; i < table.size(); ++i) {
+        table[i] = static_cast<unsigned char>(std::lround(std::pow(double(i) / 255.0, gamma) * 255.0));
+    }
+    return table;
+}
