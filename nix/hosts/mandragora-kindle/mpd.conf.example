# mandragora.koplugin / mpd.lua configuration
#
# Copy this file to /mnt/us/mandragora/mpd.conf on the device. Simple
# key=value lines; blank lines and unrecognized keys are ignored, and a
# missing file is fine — the built-in defaults below apply.

# host: the MPD server address.
#
# The tailnet address of the desktop (100.115.80.79) does NOT work here:
# this Kindle's tailscaled runs with --tun=userspace-networking and no
# local SOCKS5/HTTP proxy exposed, so it creates no system network
# interface. Plain sockets opened by other processes on the device
# (LuaSocket, busybox nc, ping) have no route to the tailnet's 100.64.0.0/10
# range and time out — only `tailscale`'s own subcommands (nc/ssh/ping) can
# reach it, via IPC to tailscaled itself, which a generic TCP client can't
# use. The Kindle and the desktop happen to share the same Wi-Fi LAN, so the
# desktop's plain LAN address works fine with a normal TCP connection. If
# the desktop's LAN IP changes (DHCP), update it here.
host=192.168.0.27

# port: MPD's listen port (services.mpd on the desktop listens on all
# interfaces at the default port).
port=6600

# vis_host / vis_port: the mandragora-mpd-vis helper, which is what makes
# the spectrum analyser and the album art possible.
#
# The Kindle is an MPD *client*, so it cannot read the server's PCM fifo and
# has no CPU budget for an FFT anyway. mandragora-mpd-vis runs on the
# desktop (nix/modules/services/mpd-vis.nix), reads /tmp/mpd.fifo, does the
# FFT there, and streams 48 band magnitudes as one 98-byte line per frame.
# The same connection serves cover art already dithered to the panel's 16
# grey levels, so the device only ever draws.
#
# vis_host defaults to `host` — set it only if the helper runs elsewhere.
vis_host=
vis_port=6612

# vis_fps: how often the device redraws the spectrum while playing. Each
# redraw is an A2 (2-level) refresh of the visualiser's bounding box only,
# which is why this is affordable at all; the rest of the screen is not
# touched. The server always streams at 10 Hz and the client takes the
# per-band maximum across whatever frames arrived since its last draw, so
# lowering this loses no peaks, only smoothness.
vis_fps=5

# vis_gc16_frames: every Nth visualiser frame is promoted from A2 to a full
# GC16 refresh of that same bounding box, which clears the ghosting A2
# accumulates. At the default 5 fps, 50 frames is one localised flash every
# ten seconds. Lower it if ghosting bothers you more than the flash does.
vis_gc16_frames=50

# poll_seconds: how often the widget asks MPD for status/currentsong while
# the screen is open. Elapsed time is interpolated locally between polls, so
# the scrubber still moves once a second without a round trip. Only a change
# in track, transport state, volume or queue triggers a full repaint.
#
# `refresh_seconds` from the previous version of this file is still accepted
# as an alias.
poll_seconds=3
