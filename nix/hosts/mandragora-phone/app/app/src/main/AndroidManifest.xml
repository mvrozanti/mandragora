        <service
            android:name=".media.PhoneMediaJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".media.MusicMirrorJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".state.InstallReceiver"
            android:exported="false" />

        <service
            android:name=".inbox.InboxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="holds a long-poll to the operator's own desktop over the tailnet so desktop alerts arrive as notifications without a push service" />
        </service>

        <receiver
            android:name=".inbox.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".inbox.InboxActionReceiver"
            android:exported="false" />

        <service
            android:name=".play.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
