KINDLE_EMAIL=yourname_abc123@kindle.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@outlook.com
FROM_ADDR=you@outlook.com
FROM_NAME=

# Either SMTP_AUTH=oauth2 with a refresh token (recommended for Microsoft
# accounts, no app password), or SMTP_AUTH=password with SMTP_PASS set.
SMTP_AUTH=oauth2
OAUTH_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
OAUTH_REFRESH_TOKEN=
OAUTH_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token

# SMTP_AUTH=password
SMTP_PASS=

MAX_UPLOAD_MB=25

# device panel — the Kindle over the tailnet
KINDLE_HOST=100.80.53.92
KINDLE_PORT=22
KINDLE_SCREEN_TTL=10
# private key lives at ./ssh/id_ed25519 (root-owned, gitignored, never committed)
